<resources>
    <!-- Base application theme -->
    <style name="Theme.Akuntansi" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/colorBackground</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/colorPrimaryText</item>
        <item name="android:textColorSecondary">@color/colorSecondaryText</item>
        
        <!-- Font Inter untuk seluruh aplikasi -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="textAppearanceHeadline4">@style/TextAppearance.Dompetku.Headline4</item>
        <item name="textAppearanceHeadline5">@style/TextAppearance.Dompetku.Headline5</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.Dompetku.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Dompetku.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.Dompetku.Subtitle2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Dompetku.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Dompetku.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.Dompetku.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.Dompetku.Button</item>

        <!-- Widget styles -->
        <item name="materialButtonStyle">@style/Widget.Akuntansi.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.Akuntansi.BottomNavigation</item>
    </style>
</resources>
